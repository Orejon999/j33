'use client';

/* eslint-disable react-hooks/set-state-in-effect */

import React, { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { Plus, Minus, ArrowUp, ArrowDown, Trash2, Image as ImageIcon, Loader2, Save, X, Sparkles } from 'lucide-react';
import { createClient } from '@/infrastructure/supabase/client';
import { Product, Category } from '@/domain/entities';
import { Button } from '@/components/ui/Button';
import { Switch } from '@/components/ui/Switch';

interface ImageState {
  id?: string;
  file?: File;
  url: string; // Blob URL for new, or public URL for existing
  label: string | null;
  position: number;
  isExisting: boolean;
  fileName?: string;
}

interface ProductFormProps {
  product?: Product; // Defined if editing
  isEdit?: boolean;
}

export const ProductForm: React.FC<ProductFormProps> = ({ product, isEdit = false }) => {
  const router = useRouter();
  const supabase = createClient();

  const [name, setName] = useState('');
  const [description, setDescription] = useState('');
  const [price, setPrice] = useState('');
  const [isVisible, setIsVisible] = useState(true);
  const [categoryId, setCategoryId] = useState('');
  const [categories, setCategories] = useState<Category[]>([]);

  const [images, setImages] = useState<ImageState[]>([]);
  const [productId] = useState(() => product?.id || crypto.randomUUID());

  const [isLoading, setIsLoading] = useState(false);
  const [categoriesLoading, setCategoriesLoading] = useState(true);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  // Load existing details if editing
  useEffect(() => {
    if (isEdit && product) {
      setName(product.name || '');
      setDescription(product.description || '');
      setPrice(product.price?.toString() || '');
      setIsVisible(product.is_visible ?? true);
      setCategoryId(product.category_id || '');
      
      const loadedImages = (product.images || []).map((img) => ({
        id: img.id,
        url: img.url,
        label: img.label,
        position: img.position,
        isExisting: true,
      }));
      setImages(loadedImages);
    }
  }, [isEdit, product]);

  // Load category alternatives
  useEffect(() => {
    const fetchCategories = async () => {
      try {
        const res = await fetch('/api/categories');
        if (res.ok) {
          const data = await res.json();
          setCategories(data);
        }
      } catch (err) {
        console.error('Error fetching categories in admin form:', err);
      } finally {
        setCategoriesLoading(false);
      }
    };
    fetchCategories();
  }, []);

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files;
    if (!files) return;

    const newImgs: ImageState[] = [];
    for (let i = 0; i < files.length; i++) {
      const file = files[i];

      // Limit size: 5MB
      if (file.size > 5 * 1024 * 1024) {
        alert(`La imagen ${file.name} supera el límite de 5MB.`);
        continue;
      }

      // Check mime type list
      const validTypes = ['image/jpeg', 'image/png', 'image/webp'];
      if (!validTypes.includes(file.type)) {
        alert(`La imagen ${file.name} no es un formato válido (.jpeg, .png, .webp).`);
        continue;
      }

      if (images.length + newImgs.length >= 10) {
        alert('Máximo podes subir hasta 10 imágenes para este producto.');
        break;
      }

      newImgs.push({
        file,
        url: URL.createObjectURL(file),
        label: '',
        position: images.length + newImgs.length,
        isExisting: false,
        fileName: file.name,
      });
    }

    setImages(prev => [...prev, ...newImgs]);
  };

  const removeImage = (index: number) => {
    setImages(prev => {
      const updated = prev.filter((_, i) => i !== index);
      // Re-map positions to be clean
      return updated.map((img, i) => ({ ...img, position: i }));
    });
  };

  const moveUp = (index: number) => {
    if (index === 0) return;
    setImages(prev => {
      const copy = [...prev];
      const temp = copy[index - 1];
      copy[index - 1] = { ...copy[index], position: index - 1 };
      copy[index] = { ...temp, position: index };
      return copy;
    });
  };

  const moveDown = (index: number) => {
    if (index === images.length - 1) return;
    setImages(prev => {
      const copy = [...prev];
      const temp = copy[index + 1];
      copy[index + 1] = { ...copy[index], position: index + 1 };
      copy[index] = { ...temp, position: index };
      return copy;
    });
  };

  const updateLabel = (index: number, text: string) => {
    setImages(prev => prev.map((img, i) => i === index ? { ...img, label: text } : img));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!name.trim() || isNaN(Number(price))) {
      setErrorMessage('Por favor ingresa un nombre y precio válido.');
      return;
    }

    setIsLoading(true);
    setErrorMessage(null);

    try {
      // 1. Process files and upload new images to Supabase Storage
      const uploadedImages: { url: string; label: string | null; position: number }[] = [];

      for (let i = 0; i < images.length; i++) {
        const item = images[i];
        
        if (item.isExisting) {
          // Carry existing image url and info
          uploadedImages.push({
            url: item.url,
            label: item.label,
            position: i, // write fresh order sequences
          });
        } else if (item.file) {
          // Upload new file to ‘product-images’ bucket
          // filename pattern: {product_id}/{position}_{filename}
          const cleanFileName = item.fileName ? item.fileName.replace(/[^a-zA-Z0-9.]/g, '') : 'img.webp';
          const storagePath = `${productId}/${i}_${cleanFileName}`;

          const { data: uploadData, error: uploadErr } = await supabase.storage
            .from('product-images')
            .upload(storagePath, item.file, {
              upsert: true,
              contentType: item.file.type,
            });

          if (uploadErr) {
            throw new Error(`Fallo de subida para ${cleanFileName}: ${uploadErr.message}`);
          }

          // Fetch public URL
          const { data: { publicUrl } } = supabase.storage
            .from('product-images')
            .getPublicUrl(storagePath);

          uploadedImages.push({
            url: publicUrl,
            label: item.label,
            position: i,
          });
        }
      }

      // 2. Submit values to internal product API
      const url = isEdit ? `/api/products/${product?.id}` : '/api/products';
      const method = isEdit ? 'PUT' : 'POST';

      const response = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: name.trim(),
          description: description.trim() || null,
          price: Number(price),
          is_visible: isVisible,
          category_id: categoryId || null,
          images: uploadedImages,
        }),
      });

      if (!response.ok) {
        const errJson = await response.json();
        throw new Error(errJson.error || 'No se pudo guardar la información del producto');
      }

      router.push('/admin');
      router.refresh();
    } catch (err: any) {
      console.error('Error submitting product form:', err);
      setErrorMessage(err.message || 'Error guardando datos de la parrilla.');
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-8 font-sans">
      
      {errorMessage && (
        <div className="p-3 bg-brand-ember/15 border border-brand-ember/40 rounded text-xs text-red-100 font-medium">
          {errorMessage}
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        {/* Left: General textual fields */}
        <div className="lg:col-span-6 bg-brand-coal border border-brand-ash/60 p-6 rounded space-y-4">
          <h3 className="text-xl font-bold uppercase tracking-wide text-white border-b border-brand-ash/60 pb-2">
            Detalles Generales
          </h3>

          {/* Name */}
          <div className="space-y-1">
            <label className="text-xs text-gray-400 font-bold uppercase">Nombre del Producto *</label>
            <input
              type="text"
              required
              placeholder="Ej: Parrilla J3RACKS Premium XL"
              value={name}
              onChange={(e) => setName(e.target.value)}
              className="w-full bg-brand-dark border border-brand-ash/80 rounded px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brand-fire"
            />
          </div>

          {/* Price */}
          <div className="space-y-1">
            <label className="text-xs text-gray-400 font-bold uppercase">Precio en Soles (S/) *</label>
            <input
              type="number"
              step="0.01"
              required
              placeholder="Ej: 1499.00"
              value={price}
              onChange={(e) => setPrice(e.target.value)}
              className="w-full bg-brand-dark border border-brand-ash/80 rounded px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brand-fire"
            />
          </div>

          {/* Category SELECT dropdown */}
          <div className="space-y-1">
            <label className="text-xs text-gray-400 font-bold uppercase">Categoría</label>
            {categoriesLoading ? (
              <p className="text-xs text-gray-500">Cargando categorías...</p>
            ) : (
              <select
                value={categoryId}
                onChange={(e) => setCategoryId(e.target.value)}
                className="w-full bg-brand-dark border border-brand-ash/80 rounded px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brand-fire cursor-pointer"
              >
                <option value="">Sin Categoría / General</option>
                {categories.map((cat) => (
                  <option key={cat.id} value={cat.id}>
                    {cat.name}
                  </option>
                ))}
              </select>
            )}
          </div>

          {/* Description */}
          <div className="space-y-1">
            <label className="text-xs text-gray-400 font-bold uppercase">Descripción de la parrilla (Opcional)</label>
            <textarea
              placeholder="Escribe acabados, medidas, espesores..."
              rows={5}
              value={description}
              onChange={(e) => setDescription(e.target.value)}
              className="w-full bg-brand-dark border border-brand-ash/80 rounded px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brand-fire font-medium"
            />
          </div>

          {/* Switch visibility toggle */}
          <div className="pt-3 flex items-center justify-between bg-brand-dark/30 p-3 rounded border border-brand-ash/40">
            <div>
              <span className="block text-sm font-semibold text-white uppercase tracking-wide">Estado de Visibilidad</span>
              <span className="text-xs text-gray-400 font-medium">Controla si se ve públicamente en la tienda</span>
            </div>
            <Switch
              checked={isVisible}
              onChange={setIsVisible}
              label={isVisible ? 'MOSTRAR EN TIENDA' : 'OCULTAR'}
            />
          </div>

        </div>

        {/* Right: Rich up to 10 Images uploads section */}
        <div className="lg:col-span-6 bg-brand-coal border border-brand-ash/60 p-6 rounded space-y-4">
          <div className="flex items-center justify-between border-b border-brand-ash/60 pb-2">
            <h3 className="text-xl font-bold uppercase tracking-wide text-white">
              Galería de Imágenes <span className="text-sm font-semibold text-brand-fire">({images.length}/10)</span>
            </h3>
            
            {/* Input Trigger */}
            <label className="text-xs font-bold uppercase text-white bg-brand-fire hover:bg-brand-fire-hover px-3 py-1.5 rounded cursor-pointer transition-colors flex items-center gap-1.5">
              <Plus className="w-3.5 h-3.5" />
              Elegir fotos
              <input
                type="file"
                multiple
                accept="image/jpeg,image/png,image/webp"
                onChange={handleFileChange}
                disabled={images.length >= 10}
                className="sr-only"
              />
            </label>
          </div>

          <div className="space-y-3 max-h-[50vh] overflow-y-auto pr-1">
            {images.length === 0 ? (
              <div className="flex flex-col items-center justify-center py-12 border-2 border-dashed border-brand-ash rounded text-center">
                <ImageIcon className="w-12 h-12 text-gray-600 mb-2" />
                <p className="text-sm font-bold text-gray-400">Sin imágenes cargadas</p>
                <p className="text-xs text-gray-600 mt-0.5">Sube hasta 10 fotos (.png, .jpg, .webp - máx 5MB)</p>
              </div>
            ) : (
              images.map((item, index) => (
                <div 
                  key={index}
                  className={`flex gap-3 p-3 rounded bg-brand-dark/40 border items-center relative group ${
                    index === 0 ? 'border-brand-fire/40 bg-brand-fire/5' : 'border-brand-ash/50'
                  }`}
                >
                  {/* Thumbnail */}
                  <div className="relative w-14 h-14 bg-black rounded overflow-hidden shrink-0">
                    <img 
                      src={item.url} 
                      alt="preview" 
                      className="w-full h-full object-cover" 
                    />
                    {index === 0 && (
                      <span className="absolute bottom-0 inset-x-0 bg-brand-fire text-white font-extrabold text-[8px] text-center uppercase tracking-wider py-0.5">
                        Principal
                      </span>
                    )}
                  </div>

                  {/* Metadata Input labeling */}
                  <div className="flex-grow space-y-1">
                    <input
                      type="text"
                      placeholder="Caption o etiqueta opcional (Ej: Vistas de elevación)"
                      value={item.label || ''}
                      onChange={(e) => updateLabel(index, e.target.value)}
                      className="w-full bg-brand-coal border border-brand-ash/40 rounded px-2 py-1 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-brand-fire"
                    />
                    <p className="text-[10px] text-gray-500 font-mono">
                      Posición: {index} • {item.isExisting ? 'En Servidor' : 'Seleccionado'}
                    </p>
                  </div>

                  {/* Reordering indicators & Delete */}
                  <div className="flex flex-col gap-1 shrink-0">
                    <button
                      type="button"
                      onClick={() => moveUp(index)}
                      disabled={index === 0}
                      className="p-1 rounded hover:bg-brand-ash text-gray-400 disabled:opacity-20 cursor-pointer"
                      title="Mover arriba"
                    >
                      <ArrowUp className="w-3.5 h-3.5" />
                    </button>
                    <button
                      type="button"
                      onClick={() => moveDown(index)}
                      disabled={index === images.length - 1}
                      className="p-1 rounded hover:bg-brand-ash text-gray-400 disabled:opacity-20 cursor-pointer"
                      title="Mover abajo"
                    >
                      <ArrowDown className="w-3.5 h-3.5" />
                    </button>
                  </div>

                  <button
                    type="button"
                    onClick={() => removeImage(index)}
                    className="p-1.5 rounded text-gray-500 hover:text-brand-ember hover:bg-brand-ash/20 ml-2 cursor-pointer shrink-0"
                    title="Quitar imagen"
                  >
                    <Trash2 className="w-4 h-4" />
                  </button>
                </div>
              ))
            )}
          </div>

        </div>

      </div>

      {/* Footer controls submission bar */}
      <div className="border-t border-brand-ash/60 pt-6 flex items-center justify-between gap-4">
        <button
          type="button"
          onClick={() => router.back()}
          className="px-5 py-2.5 rounded text-sm text-gray-400 hover:text-white border border-brand-ash hover:bg-brand-ash/30 font-semibold cursor-pointer uppercase transition-all"
        >
          Cancelar
        </button>

        <Button
          type="submit"
          variant="primary"
          disabled={isLoading}
          className="flex items-center gap-2"
        >
          {isLoading ? (
            <>
              <Loader2 className="w-4 h-4 animate-spin" />
              Guardando producto...
            </>
          ) : (
            <>
              <Save className="w-4 h-4" />
              Guardar Parrilla
            </>
          )}
        </Button>
      </div>

    </form>
  );
};

'use client';

import React, { useState, useEffect } from 'react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import { User, Phone, Mail, Flame, Save, ShieldAlert, LogOut, Loader2 } from 'lucide-react';
import { createClient } from '@/infrastructure/supabase/client';
import { Button } from '@/components/ui/Button';
import { Card, CardHeader, CardContent, CardFooter } from '@/components/ui/Card';
import { Profile } from '@/domain/entities';

export default function AccountPage() {
  const router = useRouter();
  const [profile, setProfile] = useState<Profile | null>(null);
  const [isLoading, setIsLoading] = useState(true);
  const [isSaving, setIsSaving] = useState(false);

  const [firstName, setFirstName] = useState('');
  const [lastName, setLastName] = useState('');
  const [phone, setPhone] = useState('');

  const [message, setMessage] = useState<{ type: 'success' | 'error'; text: string } | null>(null);

  useEffect(() => {
    const fetchSession = async () => {
      const supabase = createClient();
      const { data: { user }, error } = await supabase.auth.getUser();

      if (error || !user) {
        router.push('/login');
        return;
      }

      const { data: prof, error: profErr } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .single();

      if (prof) {
        setProfile(prof);
        setFirstName(prof.first_name || '');
        setLastName(prof.last_name || '');
        setPhone(prof.phone || '');
      }
      setIsLoading(false);
    };

    fetchSession();
  }, [router]);

  const handleUpdateProfile = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!profile) return;

    setIsSaving(true);
    setMessage(null);

    try {
      const supabase = createClient();
      const { error } = await supabase
        .from('profiles')
        .update({
          first_name: firstName.trim(),
          last_name: lastName.trim(),
          phone: phone.trim(),
        })
        .eq('id', profile.id);

      if (error) throw error;

      setMessage({ type: 'success', text: '¡Perfil J3RACKS actualizado con éxito!' });
    } catch (err: any) {
      console.error('Error updating profile:', err);
      setMessage({ type: 'error', text: err.message || 'Error al guardar los datos.' });
    } finally {
      setIsSaving(false);
    }
  };

  const handleSignOut = async () => {
    const supabase = createClient();
    await supabase.auth.signOut();
    router.push('/');
  };

  if (isLoading) {
    return (
      <div className="min-h-screen bg-brand-dark flex flex-col items-center justify-center p-6">
        <Loader2 className="w-10 h-10 text-brand-fire animate-spin mb-3" />
        <p className="text-sm text-gray-400">Verificando sesión del asador...</p>
      </div>
    );
  }

  return (
    <main className="min-h-screen bg-brand-dark py-12">
      <div className="max-w-2xl mx-auto px-4">
        
        <div className="flex items-center justify-between mb-8 pb-4 border-b border-brand-ash/60">
          <div>
            <h1 className="text-4xl font-extrabold uppercase text-white tracking-wide">
              Mi <span className="text-brand-fire">Cuenta</span>
            </h1>
            <p className="text-xs text-gray-400 mt-1">
              Administra tus datos personales y configuraciones.
            </p>
          </div>

          <button
            onClick={handleSignOut}
            className="text-xs text-brand-ember hover:bg-brand-ember/15 border border-brand-ember/40 rounded px-3 py-2 uppercase font-bold tracking-wide flex items-center gap-1.5 cursor-pointer transition-colors"
          >
            <LogOut className="w-4 h-4" />
            Salir
          </button>
        </div>

        <div className="grid grid-cols-1 gap-6">
          
          {/* Main profile form */}
          <Card className="bg-brand-coal border-brand-ash shadow-xl relative overflow-hidden">
            <div className="h-1 bg-brand-fire absolute inset-x-0 top-0" />
            
            <CardHeader>
              <h2 className="text-2xl font-bold uppercase text-white flex items-center gap-2">
                <User className="w-5 h-5 text-brand-fire" />
                Información de Perfil
              </h2>
            </CardHeader>

            <CardContent>
              <form onSubmit={handleUpdateProfile} className="space-y-4">
                
                {message && (
                  <div className={`p-3 rounded text-xs font-semibold ${
                    message.type === 'success' 
                      ? 'bg-green-950/40 border border-green-800 text-green-300' 
                      : 'bg-brand-ember/15 border border-brand-ember/40 text-red-200'
                  }`}>
                    {message.text}
                  </div>
                )}

                {/* Email (Readonly) */}
                <div className="space-y-1.5 opacity-70">
                  <label className="text-xs text-gray-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
                    <Mail className="w-3.5 h-3.5 text-brand-fire" />
                    Correo (No modificable)
                  </label>
                  <input
                    type="email"
                    disabled
                    value={profile?.email || ''}
                    className="w-full bg-brand-dark/50 border border-brand-ash/50 rounded px-3 py-2.5 text-sm text-gray-400"
                  />
                </div>

                {/* Name fields */}
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div className="space-y-1.5">
                    <label className="text-xs text-gray-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
                      <User className="w-3.5 h-3.5 text-brand-fire" />
                      Nombres
                    </label>
                    <input
                      type="text"
                      required
                      value={firstName}
                      onChange={(e) => setFirstName(e.target.value)}
                      className="w-full bg-brand-dark border border-brand-ash rounded px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brand-fire"
                    />
                  </div>
                  <div className="space-y-1.5">
                    <label className="text-xs text-gray-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
                      <User className="w-3.5 h-3.5 text-brand-fire" />
                      Apellidos
                    </label>
                    <input
                      type="text"
                      required
                      value={lastName}
                      onChange={(e) => setLastName(e.target.value)}
                      className="w-full bg-brand-dark border border-brand-ash rounded px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brand-fire"
                    />
                  </div>
                </div>

                {/* Phone */}
                <div className="space-y-1.5">
                  <label className="text-xs text-gray-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
                    <Phone className="w-3.5 h-3.5 text-brand-fire" />
                    Celular
                  </label>
                  <input
                    type="tel"
                    required
                    value={phone}
                    onChange={(e) => setPhone(e.target.value)}
                    className="w-full bg-brand-dark border border-brand-ash rounded px-3 py-2.5 text-sm text-white focus:outline-none focus:border-brand-fire"
                  />
                </div>

                <div className="pt-4">
                  <Button
                    type="submit"
                    variant="primary"
                    disabled={isSaving}
                    className="flex items-center justify-center gap-2 font-bold uppercase tracking-wide h-11 w-full sm:w-auto"
                  >
                    <Save className="w-4 h-4" />
                    {isSaving ? 'Guardando...' : 'GUARDAR CAMBIOS'}
                  </Button>
                </div>

              </form>
            </CardContent>
          </Card>

          {/* Admin Redirect banner if they are admins */}
          {profile?.role === 'admin' && (
            <Card className="bg-brand-fire/10 border-brand-fire/30 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div className="space-y-1">
                <h4 className="text-lg font-bold uppercase text-white flex items-center gap-1.5">
                  <ShieldAlert className="w-5 h-5 text-brand-fire animate-pulse" />
                  Perfil de Administrador Detectado
                </h4>
                <p className="text-xs text-gray-300 font-sans">
                  Tienes acceso completo para crear, editar, y reordenar parrillas, y controlar inventarios en stock.
                </p>
              </div>
              <Link href="/admin">
                <Button variant="primary" size="sm" className="font-bold uppercase tracking-wider shrink-0">
                  Ir al panel admin
                </Button>
              </Link>
            </Card>
          )}

        </div>

      </div>
    </main>
  );
}

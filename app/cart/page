'use client';

import React, { useState, useEffect } from 'react';
import Link from 'next/link';
import { ShoppingBag, ArrowLeft, Trash2, Plus, Minus, Send, User } from 'lucide-react';
import { useCart } from '@/components/shop/CartContext';
import { createClient } from '@/infrastructure/supabase/client';
import { Button } from '@/components/ui/Button';
import { Card, CardContent } from '@/components/ui/Card';
import { Profile } from '@/domain/entities';

export default function CartPage() {
  const {
    cartItems,
    updateQuantity,
    removeFromCart,
    getCartTotal,
    clearCart,
  } = useCart();

  const [shippingName, setShippingName] = useState('');
  const [profile, setProfile] = useState<Profile | null>(null);
  const [isSubmitting, setIsSubmitting] = useState(false);

  // Load authenticated profile name if logged in
  useEffect(() => {
    const fetchProfile = async () => {
      const supabase = createClient();
      const { data: { user } } = await supabase.auth.getUser();
      if (user) {
        const { data: prof } = await supabase
          .from('profiles')
          .select('*')
          .eq('id', user.id)
          .single();
        if (prof) {
          setProfile(prof);
          setShippingName(`${prof.first_name} ${prof.last_name || ''}`.trim());
        }
      }
    };
    fetchProfile();
  }, []);

  const handleCheckout = async () => {
    const nameToUse = shippingName.trim() || (profile ? `${profile.first_name} ${profile.last_name}` : 'Cliente');
    setIsSubmitting(true);
    
    try {
      // 1. Save Checkout Order history inside Supabase (Extra 3)
      const orderItems = cartItems.map(item => ({
        id: item.product_id,
        name: item.product?.name || 'Parrilla J3RACKS',
        price: item.product?.price || 0,
        quantity: item.quantity,
      }));
      const total = getCartTotal();

      const response = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: orderItems,
          total,
        }),
      });

      if (!response.ok) {
        console.warn('Could not save order history record, continuing to checkout');
      }

      // 2. Build WhatsApp Message Body
      let message = `Hola J3RACKS! Quiero hacer el siguiente pedido:\n\n`;
      cartItems.forEach((item) => {
        const pName = item.product?.name || 'Parrilla';
        const pPrice = item.product?.price || 0;
        const subtotal = pPrice * item.quantity;
        message += `${item.quantity}x ${pName} — S/ ${pPrice.toLocaleString('es-PE', { minimumFractionDigits: 2 })} (Subtotal: S/ ${subtotal.toLocaleString('es-PE', { minimumFractionDigits: 2 })})\n\n`;
      });
      message += `TOTAL: S/ ${total.toLocaleString('es-PE', { minimumFractionDigits: 2 })}\n\n`;
      message += `Mi nombre: ${nameToUse}`;

      // 3. Trigger redirect
      const whatsappNumber = process.env.NEXT_PUBLIC_WHATSAPP_NUMBER || '51997444846';
      const encodedMsg = encodeURIComponent(message);
      const url = `https://wa.me/${whatsappNumber}?text=${encodedMsg}`;

      // Clear local cart
      clearCart();

      // Redirect
      window.open(url, '_blank');
    } catch (err) {
      console.error('Checkout error:', err);
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <main className="min-h-screen bg-brand-dark py-12">
      <div className="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Header Title */}
        <div className="border-b border-brand-ash pb-5 mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h1 className="text-4xl font-extrabold uppercase text-white tracking-wide flex items-center gap-2">
              <ShoppingBag className="w-8 h-8 text-brand-fire" />
              Detalle de tu Pedido
            </h1>
            <p className="text-sm text-gray-400 font-sans mt-0.5">
              Revisa la lista de parrillas antes de proceder con el envío.
            </p>
          </div>
          <Link href="/">
            <Button variant="secondary" size="sm" className="inline-flex items-center gap-1.5">
              <ArrowLeft className="w-4 h-4" />
              Seguir Comprando
            </Button>
          </Link>
        </div>

        {cartItems.length === 0 ? (
          <div className="text-center py-20 bg-brand-coal border border-brand-ash/60 rounded">
            <ShoppingBag className="w-16 h-16 text-gray-600 mx-auto mb-4" />
            <h3 className="text-xl font-bold uppercase text-white">Tu carrito está vacío</h3>
            <p className="text-sm text-gray-500 mt-1">
              Agrega una de nuestras robustas parrillas antes de proceder al checkout.
            </p>
            <Link href="/" className="inline-block mt-6">
              <Button>Explorar Parrillas</Button>
            </Link>
          </div>
        ) : (
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            {/* Left side: Items lists */}
            <div className="lg:col-span-7 space-y-4">
              {cartItems.map((item) => {
                const p = item.product || { name: 'Parrilla J3RACKS', price: 0, images: [] };
                const imgUrl = p.images && p.images.length > 0 ? p.images[0].url : null;
                const price = p.price || 0;

                return (
                  <Card key={item.id} className="bg-brand-coal/70 border-brand-ash flex gap-4 p-4 items-center">
                    {/* Small image logo */}
                    <div className="relative w-16 h-16 bg-black rounded overflow-hidden shrink-0">
                      {imgUrl ? (
                        <img 
                          src={imgUrl} 
                          alt={p.name} 
                          className="w-full h-full object-cover" 
                        />
                      ) : (
                        <div className="w-full h-full flex items-center justify-center bg-brand-ash text-gray-500 font-bold text-xs">
                          J3R
                        </div>
                      )}
                    </div>

                    {/* Metadata */}
                    <div className="flex-grow flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                      <div>
                        <h4 className="text-lg font-bold uppercase tracking-wide text-gray-200">
                          {p.name}
                        </h4>
                        <span className="text-sm font-semibold text-brand-fire">
                          S/ {price.toLocaleString('es-PE', { minimumFractionDigits: 2 })}
                        </span>
                      </div>

                      <div className="flex items-center gap-4">
                        {/* Quantity switches */}
                        <div className="flex items-center gap-1.5 bg-brand-ash/50 rounded p-1 border border-brand-ash/40">
                          <button
                            type="button"
                            onClick={() => updateQuantity(item.product_id, item.quantity - 1)}
                            className="w-6 h-6 rounded hover:bg-brand-dark flex items-center justify-center text-gray-400 hover:text-white cursor-pointer"
                          >
                            <Minus className="w-4 h-4" />
                          </button>
                          <span className="text-sm font-bold px-2.5 text-center min-w-5 text-white">
                            {item.quantity}
                          </span>
                          <button
                            type="button"
                            onClick={() => updateQuantity(item.product_id, item.quantity + 1)}
                            className="w-6 h-6 rounded hover:bg-brand-dark flex items-center justify-center text-gray-400 hover:text-white cursor-pointer"
                          >
                            <Plus className="w-4 h-4" />
                          </button>
                        </div>

                        {/* Subtotal & trash */}
                        <div className="text-right flex items-center gap-3">
                          <span className="text-sm font-bold text-white block min-w-[80px]">
                            S/ {(price * item.quantity).toLocaleString('es-PE', { minimumFractionDigits: 2 })}
                          </span>
                          <button
                            onClick={() => removeFromCart(item.product_id)}
                            className="text-gray-500 hover:text-brand-ember p-1.5 hover:bg-brand-ash/20 rounded cursor-pointer transition-colors"
                            title="Eliminar artículo"
                          >
                            <Trash2 className="w-4 h-4" />
                          </button>
                        </div>
                      </div>
                    </div>
                  </Card>
                );
              })}
            </div>

            {/* Right side: Form & Checkout Actions */}
            <div className="lg:col-span-5 bg-brand-coal border border-brand-ash/60 rounded p-6 md:p-8 space-y-6">
              
              <h3 className="text-xl font-bold uppercase tracking-wide text-white border-b border-brand-ash pb-3">
                Resumen de Compra
              </h3>

              {/* Name Details Input */}
              <div className="space-y-1.5">
                <label className="text-xs text-gray-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
                  <User className="w-3.5 h-3.5 text-brand-fire" />
                  Nombre Completo
                </label>
                <input
                  type="text"
                  placeholder="Ej: Juan Pérez"
                  value={shippingName}
                  onChange={(e) => setShippingName(e.target.value)}
                  className="w-full bg-brand-dark border border-brand-ash/85 rounded px-3 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-brand-fire"
                />
              </div>

              {/* Summary table */}
              <div className="space-y-3 font-sans text-sm text-gray-300">
                <div className="flex justify-between">
                  <span>Subtotal</span>
                  <span>S/ {getCartTotal().toLocaleString('es-PE', { minimumFractionDigits: 2 })}</span>
                </div>
                <div className="flex justify-between">
                  <span>Envío (Cochera / Todo el país)</span>
                  <span className="text-brand-fire font-semibold">Por coordinar</span>
                </div>
                
                <div className="flex justify-between pt-4 border-t border-brand-ash/40 font-extrabold text-white text-lg">
                  <span>Total</span>
                  <span>S/ {getCartTotal().toLocaleString('es-PE', { minimumFractionDigits: 2 })}</span>
                </div>
              </div>

              {/* Trigger */}
              <Button
                variant="primary"
                fullWidth
                size="lg"
                disabled={isSubmitting}
                onClick={handleCheckout}
                className="flex items-center justify-center gap-2 font-bold uppercase tracking-wider text-sm h-12"
              >
                <Send className="w-5 h-5 animate-pulse" />
                {isSubmitting ? 'Procesando...' : 'HACER PEDIDO POR WHATSAPP'}
              </Button>

              <p className="text-[11px] text-gray-500 leading-relaxed text-center font-sans">
                Se enviará una copia de tu pedido al WhatsApp empresarial de J3RACKS. Responderemos de inmediato con la fecha de despacho y las opciones de pago.
              </p>

            </div>

          </div>
        )}

      </div>
    </main>
  );
}
